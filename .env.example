# ============================================================
# SEC EDGAR Eval Harness — environment variables
# Copy to .env and fill in real values.
# The .env file is gitignored and never committed.
#
# Usage:  source .env && export IBMCLOUD_API_KEY WXO_API_KEY USAI_API_KEY USAI_BASE_URL
# Do NOT quote values — bare KEY=value only.
# ============================================================

# ------------------------------------
# IBM Cloud (required for Code Engine deploys)
# ------------------------------------
# IBM Cloud API key — from cloud.ibm.com → Manage → Access (IAM) → API keys
IBMCLOUD_API_KEY=

# ------------------------------------
# watsonx Orchestrate (required for agent/toolkit import and chat)
# ------------------------------------
# WXO API key — from the GSA hackathon lab portal or your WXO instance
WXO_API_KEY=

# ------------------------------------
# watsonx.ai — LLM-as-judge and agent-under-test (required for eval harness)
# ------------------------------------
# Regional inference endpoint — must match the region your project lives in.
# Toronto: https://ca-tor.ml.cloud.ibm.com
# Dallas:  https://us-south.ml.cloud.ibm.com  (other regions: eu-de, eu-gb, jp-tok, au-syd)
WATSONX_URL=https://ca-tor.ml.cloud.ibm.com

# IBM Cloud API key for the account that owns the watsonx.ai project (never commit)
WATSONX_API_KEY=

# watsonx.ai project ID — project > Manage tab > General > Details section
WATSONX_PROJECT_ID=

# ------------------------------------
# Model selection (required for eval harness)
# ------------------------------------
# Model ID for the agent-under-test — MUST support tool calling.
# Confirmed available in ca-tor: meta-llama/llama-3-3-70b-instruct
AGENT_MODEL=meta-llama/llama-3-3-70b-instruct

# Model ID for the LLM-as-judge evaluators.
# Keep distinct from AGENT_MODEL to reduce self-preference bias.
# Using the same model as AGENT_MODEL is acceptable when only one is available.
JUDGE_MODEL=meta-llama/llama-3-3-70b-instruct

# ------------------------------------
# Legacy model gateway (no longer used — kept for reference only)
# ------------------------------------
# USAI_API_KEY=
# USAI_BASE_URL=

# ------------------------------------
# MCP server (optional override)
# ------------------------------------
# Code Engine streamable-HTTP endpoint for the SEC EDGAR MCP server.
# The default value is the always-warm IBM Code Engine deployment.
# Only set this if the URL changes.
# MCP_ENDPOINT=https://sec-edgar-tools-mks.2flzosib5d1z.ca-tor.codeengine.appdomain.cloud/mcp

# ------------------------------------
# Phoenix (optional override)
# ------------------------------------
# Phoenix server endpoint. The harness uses :6006 for the UI/API and
# :4317 for the OTLP collector (auto-derived in agent.py).
# PHOENIX_ENDPOINT=http://localhost:6006

# Phoenix project name that groups all experiment runs together.
# PHOENIX_PROJECT=sec-edgar-eval

# ------------------------------------
# Notes
# ------------------------------------
# The SEC EDGAR MCP server itself requires NO credentials — it calls
# the public SEC EDGAR REST API only. The variables above are only for
# the model gateway (agent + judges) and Phoenix.
